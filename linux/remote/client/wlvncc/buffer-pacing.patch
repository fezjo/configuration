+static int window_find_free_buffer(struct window* w)
+{
+	for (int i = 1; i <= 3; ++i) {
+		int idx = (w->buffer_index + i) % 3;
+		if (!w->buffers[idx]->is_attached)
+			return idx;
+	}
+	return -1;
+}
