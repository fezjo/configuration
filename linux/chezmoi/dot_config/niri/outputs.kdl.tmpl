{{- $hostName := env "CONFIG_HOST" | default .chezmoi.hostname -}}
{{- $host := index .hosts $hostName -}}
{{- if not $host }}{{ fail (printf "unknown host %q" $hostName) }}{{ end -}}
{{ range $name, $output := $host.outputs }}
output "{{ $name }}" {
    mode "{{ $output.mode }}"
    scale {{ $output.scale }}
    position x={{ $output.x }} y={{ $output.y }}
}
{{ end }}
