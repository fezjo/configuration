# config.dank has mostly useless stuff (either it is already default or I don't want it)

font-family = IosevkaTerm Nerd Font
gtk-titlebar = false
shell-integration-features = cursor,sudo,title,no-cursor,ssh-env,ssh-terminfo
theme = dankcolors
unfocused-split-opacity = 0.6
working-directory = home
window-inherit-working-directory = false

