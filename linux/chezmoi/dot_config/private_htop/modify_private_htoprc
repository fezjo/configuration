#!/bin/sh
# Preserve the installed htoprc and apply only the layout keys we care about.
set -eu

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
cat > "$tmp"

set_key() {
    key=$1
    value=$2
    if grep -q "^${key}=" "$tmp"; then
        sed -i "s|^${key}=.*|${key}=${value}|" "$tmp"
    else
        printf '%s=%s\n' "$key" "$value" >> "$tmp"
    fi
}

set_key fields '0 48 17 18 38 39 40 130 2 46 47 49 1'
set_key hide_kernel_threads 1
set_key show_program_path 1
set_key highlight_base_name 1
set_key screen_tabs 1
set_key detailed_cpu_time 0
set_key cpu_count_from_one 0
set_key show_cpu_smt_labels 0
set_key sticky_follow 1
set_key sort_key 46
set_key sort_direction -1

cat "$tmp"
