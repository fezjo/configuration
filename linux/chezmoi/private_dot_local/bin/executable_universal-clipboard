#!/bin/sh
# Universal copy/paste by sending the focused application's native shortcuts.
# Terminals use Ctrl+Shift+C/V; GUI apps use Ctrl+C/V.
set -eu

action=${1:-}
case "$action" in
    copy|paste) ;;
    *) echo "usage: universal-clipboard copy|paste" >&2; exit 1 ;;
esac

for cmd in jq wtype; do
    command -v "$cmd" >/dev/null 2>&1 || {
        echo "missing dependency: $cmd" >&2
        exit 1
    }
done

app=
compositor=
if command -v umbriel >/dev/null 2>&1; then
    if focused=$(umbriel focused-window --json 2>/dev/null); then
        app=$(printf '%s' "$focused" | jq -r '.app_id // empty' 2>/dev/null || true)
        compositor=umbriel
    fi
fi
if [ -z "$compositor" ] && command -v niri >/dev/null 2>&1; then
    if focused=$(niri msg --json focused-window 2>/dev/null); then
        app=$(printf '%s' "$focused" | jq -r '.app_id // empty' 2>/dev/null || true)
        compositor=niri
    fi
fi
if [ -z "$compositor" ]; then
    echo "universal-clipboard: no supported compositor found (niri or umbriel)" >&2
    exit 1
fi

case "$app" in
    com.mitchellh.ghostty|foot|kitty|org.wezfurlong.wezterm|Alacritty|alacritty)
        terminal=1
        ;;
    *)
        terminal=0
        ;;
esac

if [ "$terminal" -eq 1 ]; then
    mods="-M ctrl -M shift"
    unmods="-m shift -m ctrl"
else
    mods="-M ctrl"
    unmods="-m ctrl"
fi

if [ "$action" = copy ]; then
    key=c
else
    key=v
fi

exec wtype $mods -k "$key" $unmods
