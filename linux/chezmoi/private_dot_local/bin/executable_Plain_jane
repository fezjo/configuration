#!/bin/sh
# Lock the session, suspend, and play a song while it stays locked.

song="$HOME/Music/A\$AP Ferg - Plain Jane (Audio)-BwmuvqFzfLI.opus"

command -v pamixer >/dev/null 2>&1 || exit 1
command -v mpv >/dev/null 2>&1 || exit 1
[ -f "$song" ] || exit 1

volume=$(pamixer --get-volume 2>/dev/null || echo 50)
pamixer --set-volume 100 --unmute >/dev/null 2>&1

loginctl lock-session 2>/dev/null || dms ipc call lock lock 2>/dev/null || true
systemctl suspend 2>/dev/null || true

session="${XDG_SESSION_ID:-}"
locked() {
    [ -n "$session" ] || return 1
    [ "$(loginctl show-session "$session" -p LockedHint --value 2>/dev/null)" = "yes" ]
}

mpv --no-video --loop=inf --shuffle --really-quiet "$song" >/dev/null 2>&1 &
pid=$!
while kill -0 "$pid" 2>/dev/null; do
    locked || break
    sleep 1
done
kill "$pid" 2>/dev/null || true
wait "$pid" 2>/dev/null || true
pamixer --set-volume "$volume" >/dev/null 2>&1
