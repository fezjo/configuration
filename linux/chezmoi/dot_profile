#!/bin/sh
# Login-shell environment. Keep this file POSIX.
# Shell-specific aliases/functions live in .bashrc / .config/zsh/.zshrc.

. "$HOME/.config/shell/env.sh"

if [ -t 0 ]; then
    GPG_TTY=$(tty)
    export GPG_TTY
fi

# Bash login shells read .profile, not .bashrc.
if [ -n "${BASH_VERSION:-}" ] && [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi
