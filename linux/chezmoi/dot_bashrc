# ~/.bashrc

[[ $- != *i* ]] && return

. "$HOME/.config/shell/env.sh"
. "$HOME/.config/shell/aliases.sh"
. "$HOME/.config/shell-config.sh"

HISTSIZE=100000
HISTFILESIZE=200000
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/bash/history"
mkdir -p "${HISTFILE%/*}"
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend checkwinsize autocd globstar

PROMPT_DIRTRIM=2
parse_git_branch() {
    git rev-parse --abbrev-ref HEAD 2>/dev/null | sed 's/^/ (/; s/$/)/'
}
PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[33m\]$(parse_git_branch)\[\033[00m\]\$ '

# Readline: prefix history and word movement.
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'
bind '"\C-h": backward-kill-word'
bind '"\e[3;5~": kill-word'
bind '"\e[1;5C": forward-word'
bind '"\e[1;5D": backward-word'
bind 'set completion-ignore-case on'
bind 'set show-all-if-ambiguous on'
bind 'set menu-complete-display-prefix on'

if command -v fzf >/dev/null 2>&1; then
    if fzf --bash >/dev/null 2>&1; then
        eval "$(fzf --bash)"
    elif [ -r /usr/share/fzf/key-bindings.bash ]; then
        . /usr/share/fzf/key-bindings.bash
    fi
fi

if [ -t 0 ]; then
    GPG_TTY=$(tty)
    export GPG_TTY
fi
