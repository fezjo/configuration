input {
    keyboard {
        xkb {
            options "caps:escape_shifted_compose"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse
    trackpoint
}

output "eDP-1" {
    mode "1920x1080@60"
    scale 1
    transform "normal"
    position x=1280 y=0
}

